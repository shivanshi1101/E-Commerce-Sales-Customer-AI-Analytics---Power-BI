    .agg(
        customers=("customer_unique_id", "count"),
        total_spend=("monetary", "sum"),
        avg_spend=("monetary", "mean")
    )
)

cluster_impact["customer_share_%"] = (
    cluster_impact["customers"]
    / cluster_impact["customers"].sum()
    * 100
)

cluster_impact["spend_share_%"] = (
